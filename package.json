{
  "name": "@rwapact/sdk",
  "version": "1.0.3",
  "description": "Official TypeScript/JavaScript SDK for RWAPACT: The On-Chain Policy & Risk Firewall for Autonomous AI Agents Trading Real-World Assets",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/abi/index.d.ts",
      "import": "./dist/abi/index.mjs",
      "require": "./dist/abi/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rwapact",
    "rwa",
    "ai-agents",
    "risk-firewall",
    "autonomous-trading",
    "erc-8004",
    "erc-8273",
    "robinhood-chain",
    "web3",
    "defi"
  ],
  "author": "RWAPACT Protocol <dev@rwapact.app>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RWAPACT/rwapact-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/RWAPACT/rwapact-sdk/issues"
  },
  "homepage": "https://github.com/RWAPACT/rwapact-sdk#readme",
  "dependencies": {
    "viem": "^2.21.35"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
